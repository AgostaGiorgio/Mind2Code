DATABASE_URL=postgresql+asyncpg://appuser:post-password@localhost:5432/incubator
CORS_ORIGINS=["http://localhost:5173"]
# Poll PostgreSQL for progress updates written directly by external services.
ENABLE_PROGRESS_POLLING=true
POLL_INTERVAL_SECONDS=2

# n8n webhook that performs the project finalization (release).
N8N_FINALIZE_WEBHOOK_URL=https://n8n.agogi.dev/webhook-test/finalyze
FINALIZE_WEBHOOK_TIMEOUT_SECONDS=10
