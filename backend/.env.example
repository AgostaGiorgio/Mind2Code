POSTGRESQL_USER=appuser
POSTGRESQL_PASSWORD=post-password
POSTGRESQL_HOST=localhost
POSTGRESQL_PORT=5432
POSTGRESQL_DATABASE=incubator

CORS_ORIGINS=["http://localhost:5173"]
# Poll PostgreSQL for progress updates written directly by external services.
ENABLE_PROGRESS_POLLING=true
POLL_INTERVAL_SECONDS=2

# n8n webhooks used when creating a project from the UI.
# Title extraction: POST {"user_input": "..."} -> {"project_title": "..."}
N8N_PROJECT_TITLE_WEBHOOK_URL=
# Requirements generation: POST {"project_id": "<db uuid>"} -> 200
N8N_REQUIREMENTS_WEBHOOK_URL=
N8N_CODE_WEBHOOK_URL=
N8N_TEST_WEBHOOK_URL=
N8N_REVIEW_WEBHOOK_URL=
N8N_RETROSPECTIVE_WEBHOOK_URL=
N8N_FINALIZE_WEBHOOK_URL=
# Shared timeout for every n8n webhook call.
N8N_TIMEOUT_SECONDS=120

# Orbit integration (umbrella dashboard).
# Full registration endpoint; leave unset to run without Orbit.
ORBIT_API_URL=https://api.orbit.agogi.dev/api/v1/register
# Public URL of this service (absolute http(s) URL, validated by Orbit).
APP_URL=https://mind2code.agogi.dev
